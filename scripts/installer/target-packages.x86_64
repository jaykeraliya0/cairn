# Packages pacstrapped into the target system (not the live ISO — see
# profile/packages.x86_64 for that). One package per line; blank lines and
# '#' comments are ignored.

# Base system
base
linux
linux-firmware

# Filesystem tools needed on the installed system
btrfs-progs

# Basics
sudo

# Networking (services enabled in the chroot step)
iwd
networkmanager

# Desktop (Hyprland + login manager, service enabled in the chroot step)
hyprland
sddm
alacritty
waybar
rofi
mako
swaybg

# Audio
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
pipewire-audio
wireplumber

# Authentication agent
polkit
hyprpolkitagent
