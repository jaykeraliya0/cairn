# Cairn default mako config -- Last of Us theme.
# Colors match ~/.config/hypr/colors.lua; see the comment there.
# Matched to hyprland.lua's decoration (rounding=3, border_size=1, gaps_out=4)
# and waybar's height (30px).

font=JetBrainsMono Nerd Font Propo 10
background-color=#1a1815f2
text-color=#fffdf5
border-color=#f7c594ee
progress-color=over #352b21

border-size=1
border-radius=4
padding=10,14
width=380
height=160

# Sits under waybar (30px) with gaps_out (4px); 4px between stacked popups
outer-margin=34,4
margin=4

icons=1
max-icon-size=48
markup=1
format=<span color="#f7c594"><b>%a</b></span>\n<b>%s</b>\n%b
text-alignment=left

layer=overlay
anchor=top-right
max-visible=5
sort=-time
default-timeout=5000
ignore-timeout=0
history=1
group-by=app-name

on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss-all
on-touch=dismiss

[grouped]
format=<b>%s</b>\n%b

[urgency=low]
border-color=#352b21aa
text-color=#a89e8d
default-timeout=3000

[urgency=normal]
border-color=#f7c594ee

[urgency=critical]
border-color=#f06060
background-color=#1a1815fa
default-timeout=0

[mode=do-not-disturb]
invisible=1
